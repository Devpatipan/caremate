# CareMate — คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงจาก Supabase
# (Supabase Dashboard → Project Settings → Data API / API Keys)
#
# ⚠️ ใช้ EXPO_PUBLIC_ นำหน้าเท่านั้น ค่าเหล่านี้ฝังในแอป (client) — ปลอดภัยเพราะมี RLS
# ห้ามใส่ service_role key ที่นี่เด็ดขาด

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-public-key...
